# Variables de entorno de ejemplo
# Puerto y entorno
PORT=3000
NODE_ENV=development

# API
API_KEY=tu_api_key_aqui
CORS_ORIGIN=*

# Base de datos: puede usar DB_URL (connection string) o las credenciales separadas
# Ejemplo usando connection string (Postgres):
# DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_URL=
DATABASE_URL=

# O usar credenciales separadas
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mi_bd
DB_USER=usuario
DB_PASSWORD=contraseña
